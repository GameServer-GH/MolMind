# docs/：内部材料，不入库
docs/

# 早期原型（正式树为 apps/services/packages；体积大且含独立 venv）
mvp/
mvp2/

# Python 虚拟环境与构建产物
.venv/
venv/
env/
*.egg-info/
dist/
build/
*.egg

# Node（仅 apps/web 用于构建 Tailwind CSS）
node_modules/
apps/web/node_modules/

# 缓存与字节码
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.molmind_cache/
.coverage
htmlcov/

# 运行产出（保留目录占位可用 .gitkeep）
output/
**/output/*.csv
**/output/*.note.txt
**/output/*.md
**/output/diagnostics/

# 本地/密钥
.env
.env.*
!.env.example
*.pem
*.key

# 服务器部署（nginx + TLS + 生产 Compose，含证书，不入库）
deploy_pro/

# 离线镜像包（体积 GB 级，不入库；目录占位见 deploy/images/.gitkeep）
deploy/images/*.tar
deploy/images/*.tar.gz
deploy/images/*.tgz

.DS_Store
.idea/
.vscode/
*.swp
*~

# 证据自动缓存（可再生）
data/evidence_snapshot/auto_cache.jsonl
data/evidence_snapshot/*.jsonl.bak

# Public data may be GB-scale and remains in-project, but raw/processed files
# require an explicit manifest and should not be committed accidentally.
data/public/raw/**
!data/public/raw/.gitkeep
data/public/processed/**
!data/public/processed/.gitkeep
data/public/models/**
!data/public/models/.gitkeep
# Manifests are small audit artifacts and should remain reviewable/committable.
