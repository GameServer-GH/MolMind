# MolMind 环境变量示例
#
# 本地与生产一致：PostgreSQL 为会话/事件/队列/Job 真源；Redis 为短锁与扇出；
# Blob 默认本地目录，可切 MinIO/S3。不再支持 FileRunStore / SQLite 队列默认后端。

# 默认无需配置即可启用 LLM（deepseek-v4-pro）。
# 仅在需要覆盖时设置：
# MOLMIND_LLM_API_KEY=sk-...
# MOLMIND_LLM_BASE_URL=https://api.deepseek.com/v1
# MOLMIND_LLM_MODEL=deepseek-v4-pro
# MOLMIND_LLM_MECHANISM=0              # 强制关闭机制 PDF LLM，只用模板
# MOLMIND_LLM_NOMINATION_REVIEW=0      # 强制关闭短名单 LLM 复核草案（回退规则）
# MOLMIND_LLM_USE_EMBEDDED=0           # 禁用代码内嵌入 Key

# MOLMIND_MODE=auto
# MOLMIND_REVIEW_SESSION_DIR=/tmp/molmind_review_sessions  # 人工复核会话落盘目录（防 reload/多 worker 丢会话）

# EPA CTX / CompTox API (ToxCast Bioactivity by DTXSID). Free key:
# email ccte_api@epa.gov — without it, importer uses committed fixtures only.
# Optional runtime override; bundled configs live in configs/evidence_providers.yaml.
# CTX_API_KEY=
# CCTE_API_KEY=
## SCP Hub MCP（默认使用代码内嵌入 Key；仅在需要覆盖或禁用时设置）
## Compose：docker compose --env-file .env -f deploy/docker-compose.yml up
## （compose 文件在 deploy/，不会自动读取仓库根 .env）
# SCP_HUB_API_KEY=
# MOLMIND_SCP_USE_EMBEDDED=0           # 禁用代码内嵌入 SCP Key

# --- Storage (required for agent) ---
# Compose 默认把 Postgres 映射到宿主机 15432；容器内主机名为 postgres:5432。
MOLMIND_DATABASE_URL=postgresql://molmind:molmind@127.0.0.1:15432/molmind
MOLMIND_AGENT_QUEUE_URL=postgresql://molmind:molmind@127.0.0.1:15432/molmind
# Redis：短锁与事件扇出。设为空字符串可禁用并降级到 PostgreSQL advisory lock。
MOLMIND_REDIS_URL=redis://127.0.0.1:6379/0
# Blob：默认本地目录；对象存储示例（需 compose --profile object 起 MinIO）：
# MOLMIND_BLOB_ROOT=data/agent_blobs
# MOLMIND_BLOB_STORE_URL=s3://molmind-blobs/agent-blobs
# MOLMIND_S3_ENDPOINT=http://127.0.0.1:19000
# MOLMIND_S3_ACCESS_KEY=molmind
# MOLMIND_S3_SECRET_KEY=molmindsecret
# MOLMIND_S3_REGION=us-east-1

MOLMIND_AGENT_WORKERS=2
MOLMIND_AGENT_LEASE_SECONDS=60
# Background Mechanism/SCP jobs: lease heartbeat + crash reclaim.
# MOLMIND_JOB_LEASE_SECONDS=120
# MOLMIND_JOB_STALE_SECONDS=120
# MOLMIND_JOB_MAX_ATTEMPTS=5
MOLMIND_WEB_WORKERS=1
